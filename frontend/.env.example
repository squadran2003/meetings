# Backend API base URL (leave empty to use same-origin relative paths)
# Example for cross-origin: VITE_API_URL=https://your-backend.railway.app
VITE_API_URL=

# WebSocket base URL (leave empty to auto-detect from window.location)
# Example for cross-origin: VITE_WS_URL=wss://your-backend.railway.app
VITE_WS_URL=

# TURN server for production (get free credentials from metered.ca)
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
